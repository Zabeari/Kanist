{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kanist",
  "version": "0.1.0",
  "identifier": "com.kanist.app",
  "build": {
    "frontendDist": "../dist/kanist-desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "ng serve",
    "beforeBuildCommand": "ng build --base-href ./"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kanist",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:8080 http://127.0.0.1:8080 https:",
        "font-src": "'self' asset:",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: blob: data:",
        "media-src": "'none'",
        "object-src": "'none'",
        "style-src": "'unsafe-inline' 'self' asset:"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:4200 wss://localhost:4200 http://localhost:4200 http://localhost:8080 http://127.0.0.1:8080 https:",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "img-src": "'self' blob: data:",
        "media-src": "'none'",
        "object-src": "'none'",
        "style-src": "'unsafe-inline' 'self'"
      },
      "freezePrototype": true,
      "capabilities": ["default"],
      "headers": {
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
